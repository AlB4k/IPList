<Window x:Class="IPList.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="IPList" Width="1120" Height="780" MinWidth="840" MinHeight="600" Closing="Window_Closing">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVisible"/>
    <Style TargetType="Button"><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="3"/></Style>
    <Style TargetType="TextBox"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="5"/></Style>
  </Window.Resources>
  <Grid Margin="15"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,8"><StackPanel DockPanel.Dock="Left"><TextBlock Text="IPList" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Маршруты AmneziaVPN и AmneziaWG" Foreground="Gray"/></StackPanel><Button Content="Проверить сейчас" Command="{Binding RefreshCommand}" HorizontalAlignment="Right"/></DockPanel>
    <Border Grid.Row="1" Background="#FFF2F4F7" Padding="8" Margin="0,0,0,8"><StackPanel><ProgressBar Height="4" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisible}}"/><TextBlock Text="{Binding Status}"/><TextBlock Text="{Binding Error}" Foreground="Firebrick" TextWrapping="Wrap"/><TextBlock Text="{Binding Freshness}" Foreground="Gray"/></StackPanel></Border>
    <TabControl x:Name="Pages" Grid.Row="2" SelectionChanged="Pages_SelectionChanged">
      <TabItem Header="Каталог"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><TextBox x:Name="SearchBox" Width="330" HorizontalAlignment="Left" TextChanged="SearchBox_TextChanged"/><TextBlock Text="Поиск по названию, домену, ASN, IP или CIDR" Foreground="Gray"/></StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,8"><TextBlock Text="Режим:" VerticalAlignment="Center"/><ComboBox x:Name="CatalogMode" Width="270" SelectionChanged="Mode_SelectionChanged"><ComboBoxItem Content="Точечный обход" Tag="Targeted"/><ComboBoxItem Content="Компактный IP-список (Lite)" Tag="Lite"/><ComboBoxItem Content="Полный российский сегмент" Tag="Full"/></ComboBox><Button Content="Выбрать всё" Click="SelectAll_Click"/><Button Content="Снять всё" Click="ClearAll_Click"/><CheckBox x:Name="RemainderCheck" Content="Остальные сети источника" Checked="Remainder_Changed" Unchecked="Remainder_Changed"/></WrapPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Локальный каталог доступен сразу; маршруты появятся после проверки источников." Foreground="Gray" TextWrapping="Wrap"/><ItemsControl x:Name="CatalogList" ItemsSource="{Binding Services}">
          <ItemsControl.GroupStyle><GroupStyle><GroupStyle.ContainerStyle><Style TargetType="GroupItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem"><Expander IsExpanded="False" Margin="0,8,0,2"><Expander.Header><DockPanel><Button Content="Выбрать" Tag="{Binding Name}" Click="SelectCategory_Click" DockPanel.Dock="Right"/><Button Content="Снять" Tag="{Binding Name}" Click="ClearCategory_Click" DockPanel.Dock="Right"/><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel></Expander.Header><ItemsPresenter/></Expander></ControlTemplate></Setter.Value></Setter></Style></GroupStyle.ContainerStyle></GroupStyle></ItemsControl.GroupStyle>
          <ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#FFD9DDE3" BorderThickness="0,0,0,1" Padding="4"><StackPanel><DockPanel><CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}" Tag="{Binding Id}" Checked="Service_Changed" Unchecked="Service_Changed"/><TextBlock Text="Маршрутов: " Foreground="Gray" VerticalAlignment="Center"/><TextBlock Text="{Binding RouteCount}" Foreground="Gray" VerticalAlignment="Center"/></DockPanel><Expander Header="Домены, ASN, маршруты и свежесть" Margin="25,0"><StackPanel><TextBlock Text="{Binding Evidence}" Foreground="Gray"/><TextBlock Text="{Binding Details}" TextWrapping="Wrap"/></StackPanel></Expander></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl></StackPanel></ScrollViewer>
      </Grid></TabItem>
      <TabItem Header="Мои IP"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <CheckBox x:Name="ManualEnabledCheck" Content="Включать мои IP в выгрузку" Checked="ManualEnabled_Changed" Unchecked="ManualEnabled_Changed"/>
        <StackPanel Grid.Row="1"><TextBlock Text="IPv4 и CIDR можно разделять пробелом, запятой или точкой с запятой." Foreground="Gray"/><WrapPanel><TextBox x:Name="ManualInput" Width="330" ToolTip="IPv4 или CIDR"/><TextBox x:Name="ManualGroup" Width="150" ToolTip="Группа"/><TextBox x:Name="ManualNote" Width="210" ToolTip="Заметка"/><Button Content="Добавить" Click="AddManual_Click"/></WrapPanel><WrapPanel><Button Content="Импорт JSON…" Click="ImportJson_Click"/><Button Content="Копировать выбранный" Click="CopySelectedManual_Click"/><Button Content="Копировать все" Click="CopyManual_Click"/><Button Content="Удалить выбранный" Click="DeleteManual_Click"/><Button Content="Обновить группу/заметку" Click="UpdateManual_Click"/></WrapPanel></StackPanel>
        <DataGrid x:Name="ManualGrid" Grid.Row="2" ItemsSource="{Binding ManualRoutes}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="ManualGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="IPv4 / CIDR" Binding="{Binding Value}" Width="*"/><DataGridTextColumn Header="Группа" Binding="{Binding Group}" Width="*"/><DataGridTextColumn Header="Заметка" Binding="{Binding Note}" Width="2*"/></DataGrid.Columns></DataGrid>
      </Grid></TabItem>
      <TabItem Header="Изменения"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Последние 100 проверок; открытие страницы отмечает изменения просмотренными." Foreground="Gray"/><ListBox Grid.Row="1" ItemsSource="{Binding History}"><ListBox.ItemTemplate><DataTemplate><Expander><Expander.Header><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding At}" FontWeight="SemiBold"/><TextBlock Text=" · "/><TextBlock Text="{Binding Reason}"/><TextBlock Text=" · +"/><TextBlock Text="{Binding Added}"/><TextBlock Text=" / −"/><TextBlock Text="{Binding Removed}"/></StackPanel></Expander.Header><StackPanel><TextBlock Text="Добавлены:" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding AddedRoutes}"/><TextBlock Text="Удалены:" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding RemovedRoutes}"/></StackPanel></Expander></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></TabItem>
      <TabItem Header="Выгрузка"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="ExportSummary" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="JSON AmneziaVPN и AllowedIPs используют один выбранный набор. Full может быть слишком велик для мобильного клиента." Foreground="Gray" TextWrapping="Wrap"/></StackPanel><WrapPanel Grid.Row="1" Margin="0,8"><Button Content="Сохранить JSON…" Click="SaveJson_Click"/><Button Content="Копировать AllowedIPs" Click="CopyAllowed_Click"/><Button Content="Сохранить AllowedIPs…" Click="SaveAllowed_Click"/><Button Content="Создать .conf…" Click="ConfWizard_Click"/><Button Content="Открыть папку автосохранения" Click="OpenExportFolder_Click"/></WrapPanel><TextBox Grid.Row="2" Text="{Binding RoutesText, Mode=OneWay}" FontFamily="Consolas" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/></Grid></TabItem>
      <TabItem Header="Настройки"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Text="Режим и профили" FontSize="17" FontWeight="SemiBold"/><WrapPanel><ComboBox x:Name="SettingsMode" Width="270" SelectionChanged="Mode_SelectionChanged"><ComboBoxItem Content="Точечный обход" Tag="Targeted"/><ComboBoxItem Content="Компактный IP-список (Lite)" Tag="Lite"/><ComboBoxItem Content="Полный российский сегмент" Tag="Full"/></ComboBox><TextBox x:Name="ProfileName" Width="170" ToolTip="Имя профиля"/><Button Content="Сохранить профиль" Click="SaveProfile_Click"/><ComboBox x:Name="ProfileList" Width="170"/><Button Content="Применить" Click="ApplyProfile_Click"/><Button Content="Удалить" Click="DeleteProfile_Click"/></WrapPanel>
        <TextBlock Text="Источники HTTPS" FontSize="17" FontWeight="SemiBold" Margin="0,16,0,4"/><TextBlock Text="Каталог metadata"/><TextBox x:Name="MetadataUrl"/><TextBlock Text="Точечный список"/><TextBox x:Name="TargetedUrl"/><TextBlock Text="Lite список"/><TextBox x:Name="LiteUrl"/><TextBlock Text="Full список"/><TextBox x:Name="FullUrl"/>
        <TextBlock Text="Расписание и приложение" FontSize="17" FontWeight="SemiBold" Margin="0,16,0,4"/><WrapPanel><CheckBox x:Name="AutomaticCheck" Content="Автоматически проверять"/><TextBlock Text="Каждые часов:" VerticalAlignment="Center"/><TextBox x:Name="IntervalBox" Width="65"/><CheckBox x:Name="NotificationsCheck" Content="Уведомления"/><CheckBox x:Name="TrayCheck" Content="Значок в трее"/><CheckBox x:Name="CloseToTrayCheck" Content="Закрывать в трей"/></WrapPanel><WrapPanel><Button Content="Сохранить настройки" Click="SaveSettings_Click"/><Button Content="Проверить URL" Click="CheckSources_Click"/><Button Content="Проверить источники" Command="{Binding RefreshCommand}"/></WrapPanel><TextBlock x:Name="LastCheckText" Foreground="Gray"/><ItemsControl ItemsSource="{Binding Diagnostics}"/></StackPanel></ScrollViewer></TabItem>
    </TabControl>
  </Grid>
</Window>
