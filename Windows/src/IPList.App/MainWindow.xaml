<Window x:Class="IPList.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="IPList" Width="1100" Height="760" MinWidth="800" MinHeight="560">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16">
      <TextBlock Text="IPList" FontSize="28" FontWeight="SemiBold" DockPanel.Dock="Left"/>
      <Button Content="Проверить сейчас" Padding="16,8" HorizontalAlignment="Right" Click="Refresh_Click"/>
    </DockPanel>
    <TabControl Grid.Row="1">
      <TabItem Header="Каталог"><TextBlock Margin="20" Text="Каталог сервисов загружается после подключения Core refresh pipeline." TextWrapping="Wrap"/></TabItem>
      <TabItem Header="Мои IP"><TextBlock Margin="20" Text="Ручные IPv4 и CIDR будут подключены к общему состоянию и экспорту." TextWrapping="Wrap"/></TabItem>
      <TabItem Header="Изменения"><TextBlock Margin="20" Text="История обновлений."/></TabItem>
      <TabItem Header="Выгрузка"><TextBlock Margin="20" Text="JSON и AllowedIPs будут доступны после выбора маршрутов." TextWrapping="Wrap"/></TabItem>
      <TabItem Header="Настройки"><TextBlock Margin="20" Text="Источники, расписание и уведомления."/></TabItem>
    </TabControl>
  </Grid>
</Window>
